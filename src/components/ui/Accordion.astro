---
// 3.15 Accordion FAQ [CLIENTE] con <details>/<summary> + JSON-LD FAQPage.
interface Props { items: { q: string; a: string }[]; schema?: boolean }
const { items, schema = true } = Astro.props;
const ld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class="acc">
  {items.map((i) => (
    <details class="acc__item" data-faq>
      <summary class="acc__q">
        <span>{i.q}</span>
        <span class="acc__icon" aria-hidden="true"></span>
      </summary>
      <div class="acc__a"><p>{i.a}</p></div>
    </details>
  ))}
</div>
{schema && items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<style is:global>
  .acc { max-width: 780px; margin-inline: auto; }
  .acc__item {
    border: .8px solid var(--c-border); background: var(--c-bg-muted); margin-bottom: 10px;
    transition: background-color .3s;
  }
  .acc__item[open] { background: #FFF; }
  .acc__q {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 20px; cursor: pointer; list-style: none;
    font-family: var(--font-heading); font-weight: 500; font-size: var(--fs-faq); line-height: 1.3; color: var(--c-text-muted);
  }
  .acc__q::-webkit-details-marker { display: none; }
  .acc__item[open] .acc__q { color: var(--c-text); }
  .acc__icon { position: relative; width: 17px; height: 17px; flex: none; }
  .acc__icon::before, .acc__icon::after {
    content: ""; position: absolute; left: 0; top: 7.5px; width: 17px; height: 2px; background: var(--c-primary-500);
    transition: transform .3s;
  }
  .acc__icon::after { transform: rotate(90deg); }
  .acc__item[open] .acc__icon::after { transform: rotate(0); }
  .acc__a { padding: 0 20px 4px; }
  .acc__a p { font-size: 1.0625rem; line-height: 1.65; }
  /* Apertura animada (300 ms) donde el navegador lo soporte */
  .acc__item::details-content { block-size: 0; overflow: hidden; transition: block-size .3s, content-visibility .3s allow-discrete; }
  .acc__item[open]::details-content { block-size: auto; }
</style>
