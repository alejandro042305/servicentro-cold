---
// Layout principal: SEO, fuentes autoalojadas, Consent Mode v2 + GTM, JSON-LD HVACBusiness,
// header, footer, barra móvil, burbujas y banner de cookies.
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-500.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/animations.css';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import BottomNav from '../components/layout/BottomNav.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { SITE } from '../config/site';
import { GTM_ID } from '../config/tracking';
import { SERVICIOS, WA_MSG_GENERAL, type ServicioSlug } from '../config/servicios';
import { localBusinessLd } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  servicio?: ServicioSlug | string;
  waMsg?: string;
  noindex?: boolean;
  canonical?: string;
  ogImage?: string;
  schema?: object[];
  readProgress?: boolean;
  /** Layout de landing de Ads: sin menú ni footer de navegación. */
  landing?: boolean;
}
const {
  title, description, servicio, waMsg: waMsgProp, noindex = false, canonical, ogImage = '/og/og-default.jpg',
  schema = [], readProgress = false, landing = false,
} = Astro.props;
const waMsg = waMsgProp ?? (servicio && servicio in SERVICIOS ? SERVICIOS[servicio as ServicioSlug].waMsg : WA_MSG_GENERAL);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogUrl = new URL(base + ogImage.replace(/^\//, ''), Astro.site).href;
const ld = [localBusinessLd(Astro.site!), ...schema];

const consentDefault = `
document.documentElement.classList.add('js');
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
var c=null;try{c=JSON.parse(localStorage.getItem('sa_consent'));}catch(e){}
var a=c&&c.ads?'granted':'denied',n=c&&c.analytics?'granted':'denied';
gtag('consent','default',{ad_storage:a,ad_user_data:a,ad_personalization:a,analytics_storage:n,wait_for_update:500});
gtag('set','ads_data_redaction',a==='denied');gtag('set','url_passthrough',true);`;
const gtm = GTM_ID
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`
  : '';
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#0047B9" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content={SITE.nombre} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />

  <script is:inline set:html={consentDefault} />
  {gtm && <script is:inline set:html={gtm} />}
  {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body data-servicio={servicio ?? 'general'} class:list={{ 'is-landing': landing }}>
  {GTM_ID && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>}
  <a href="#main" class="skip-link">Saltar al contenido</a>
  {readProgress && <div class="read-progress" aria-hidden="true"></div>}
  {landing ? <slot name="header" /> : <Header waMsg={waMsg} />}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer minimal={landing} />
  {landing ? <MobileActionBar waMsg={waMsg} always /> : <BottomNav />}
  <WhatsAppFloat waMsg={waMsg} />
  <ConsentBanner />

  <script>
    import { initReveal } from '../scripts/reveal';
    import { initCounters } from '../scripts/counters';
    import { initMotion } from '../scripts/motion';
    import { initAttribution } from '../scripts/attribution';
    import { initTracking } from '../scripts/tracking';
    import { initConsent } from '../scripts/consent';
    import { initForms } from '../scripts/form';
    initReveal();
    initCounters();
    initMotion();
    initAttribution();
    initTracking();
    initConsent();
    initForms();
  </script>
</body>
</html>
