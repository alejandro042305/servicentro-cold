---
// Páginas legales: hero interno + texto largo (plantillas para revisión legal del cliente).
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
interface Props { title: string; description: string; actualizado?: string }
const { title, description, actualizado } = Astro.props;
---
<BaseLayout title={`${title} | Serviaires`} {description}>
  <PageHero title={title} crumbs={[{ label: title }]} />
  <section class="section">
    <div class="container">
      <article class="prose">
        {actualizado && <p class="microcopy">Última actualización: {actualizado}</p>}
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
