---
// 5.6 Chillers: qué es (diagrama SVG animado), aire vs. agua, capacidades + conversor, aplicaciones, servicios, datos y formulario.
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import CompareTable from '../../../components/sections/CompareTable.astro';
import FeatureList from '../../../components/sections/FeatureList.astro';
import CaseStudies from '../../../components/sections/CaseStudies.astro';
import FAQ from '../../../components/sections/FAQ.astro';
import ProjectForm from '../../../components/forms/ProjectForm.astro';
import RelatedServices from '../../../components/sections/RelatedServices.astro';
import { SERVICIOS } from '../../../config/servicios';
import { waHref } from '../../../lib/data';
import { serviceLd } from '../../../lib/schema';
import { getCasos } from '../../../lib/content';
import faq from '../../../content/faq/chillers.json';

const slug = 'chillers';
const entry = await getEntry('servicios', slug);
const d = entry!.data as Record<string, any>;
const svc = SERVICIOS[slug];
const casos = await getCasos({ tipo: 'Chiller' });
---
<BaseLayout title={d.seo.title} description={d.seo.description} servicio={slug} readProgress
  schema={[serviceLd(Astro.site!, 'Chillers industriales', d.seo.description, svc.href)]}>
  <PageHero title={d.hero.h1} subtitle={d.hero.sub} eyebrow={d.hero.eyebrow} photo={d.hero.foto} photoAlt={d.hero.fotoAlt} deco="fan"
    crumbs={[{ label: 'Servicios' }, { label: svc.nombre }]}>
    <span data-ubicacion="hero" style="display:contents">
      <Button href="#proyecto" variant="white" icon="lucide:calendar" bob>Dimensionar mi chiller</Button>
      <Button href={waHref(svc.waMsg)} variant="whatsapp" icon="whatsapp">WhatsApp</Button>
    </span>
  </PageHero>

  <section class="section" id="que-es" aria-labelledby="qe-h">
    <div class="container">
      <SectionHeading id="qe-h" eyebrow={d.queEs.eyebrow} title={d.queEs.titulo} intro={d.queEs.intro} />
      <div class="ch-flow">
        <svg class="ch-diagram" viewBox="0 0 640 260" role="img" aria-labelledby="ch-diag-t">
          <title id="ch-diag-t">Circuito de agua: el chiller enfría el agua, la bomba la lleva al proceso y el agua retorna caliente al chiller.</title>
          <rect x="20" y="70" width="170" height="120" rx="16" fill="#0047B9" />
          <text x="105" y="125" text-anchor="middle" class="t-w">CHILLER</text>
          <text x="105" y="150" text-anchor="middle" class="t-ws">enfría el agua</text>
          <rect x="450" y="70" width="170" height="120" rx="16" fill="#F4F4F4" stroke="#0775DB" stroke-width="2" />
          <text x="535" y="125" text-anchor="middle" class="t-b">PROCESO</text>
          <text x="535" y="150" text-anchor="middle" class="t-bs">máquina o edificio</text>
          <path d="M190 100 H450" class="pipe pipe--cold" />
          <path d="M450 160 H190" class="pipe pipe--hot" />
          <path d="M190 100 H450" class="flow flow--cold" />
          <path d="M450 160 H190" class="flow flow--hot" />
          <text x="320" y="88" text-anchor="middle" class="t-l">Agua fría →</text>
          <text x="320" y="188" text-anchor="middle" class="t-l">← Retorno de agua caliente</text>
          <circle cx="320" cy="100" r="14" fill="#FFF" stroke="#0775DB" stroke-width="2" />
          <text x="320" y="105" text-anchor="middle" class="t-p">B</text>
          <text x="320" y="240" text-anchor="middle" class="t-bs">B = bomba de circulación</text>
        </svg>
        <ol class="ch-steps">
          {d.queEs.pasos.map((p: { titulo: string; texto: string }, i: number) => (
            <li data-reveal="up"><span>{i + 1}</span><div><h3>{p.titulo}</h3><p>{p.texto}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <CompareTable id="aire-agua" tone="soft" eyebrow={d.comparativa.eyebrow} titulo={d.comparativa.titulo} columnas={d.comparativa.columnas} filas={d.comparativa.filas} />

  <section class="section" id="capacidades" aria-labelledby="cap-h">
    <div class="container split">
      <div>
        <SectionHeading id="cap-h" eyebrow={d.capacidades.eyebrow} title={d.capacidades.titulo} align="left" />
        <p>{d.capacidades.texto}</p>
        <p class="microcopy">1 TR = 12.000 BTU/h = 3,517 kW</p>
      </div>
      <form class="conv" data-conv aria-label="Conversor de unidades de capacidad">
        <p class="conv__t"><Icon name="lucide:calculator" size={20} />Conversor de capacidad</p>
        <div class="field"><label class="field__label" for="cv-tr">Toneladas de refrigeración (TR)</label><input class="field__input" id="cv-tr" name="tr" type="number" inputmode="decimal" min="0" step="any" value="10" /></div>
        <div class="field"><label class="field__label" for="cv-btu">BTU/h</label><input class="field__input" id="cv-btu" name="btu" type="number" inputmode="decimal" min="0" step="any" value="120000" /></div>
        <div class="field"><label class="field__label" for="cv-kw">kW</label><input class="field__input" id="cv-kw" name="kw" type="number" inputmode="decimal" min="0" step="any" value="35.17" /></div>
      </form>
    </div>
  </section>

  <FeatureList id="aplicaciones" tone="soft" eyebrow={d.aplicaciones.eyebrow} titulo={d.aplicaciones.titulo} items={d.aplicaciones.items} />

  <section class="section" id="servicios-chiller" aria-labelledby="sc-h">
    <div class="container">
      <SectionHeading id="sc-h" eyebrow={d.servicios.eyebrow} title={d.servicios.titulo} />
      <ul class="chips chips--center">{d.servicios.items.map((s: string) => <li class="chip">{s}</li>)}</ul>
      <div class="need" data-reveal="up">
        <h3>{d.datos.titulo}</h3>
        <ul class="checks checks--blue">{d.datos.items.map((s: string) => <li>{s}</li>)}</ul>
        <p class="microcopy">{d.datos.nota}</p>
      </div>
    </div>
  </section>

  <CaseStudies casos={casos} />

  <section class="section dot-grid" id="proyecto" aria-labelledby="pf-h" data-ubicacion="contact">
    <div class="container">
      <SectionHeading id="pf-h" eyebrow="Dimensionamiento" title="Cuéntanos qué necesitas enfriar" intro="Si tienes caudal y temperaturas, inclúyelos en «Capacidad o medidas». Si no, los medimos en la visita." />
      <div class="pf-card"><ProjectForm id="pf-ch" servicioOrigen={slug} tipo="Chiller" /></div>
    </div>
  </section>

  <FAQ items={faq} tone="white" titulo="Preguntas sobre chillers" />
  <RelatedServices actual={slug} />
</BaseLayout>

<script>
  // Conversor TR ↔ BTU/h ↔ kW (1 TR = 12.000 BTU/h = 3,517 kW)
  const f = document.querySelector<HTMLFormElement>('[data-conv]');
  if (f) {
    const tr = f.elements.namedItem('tr') as HTMLInputElement;
    const btu = f.elements.namedItem('btu') as HTMLInputElement;
    const kw = f.elements.namedItem('kw') as HTMLInputElement;
    const r = (n: number, d = 2) => String(Math.round(n * 10 ** d) / 10 ** d);
    tr.addEventListener('input', () => { const v = Number(tr.value) || 0; btu.value = r(v * 12000, 0); kw.value = r(v * 3.517); });
    btu.addEventListener('input', () => { const v = Number(btu.value) || 0; tr.value = r(v / 12000); kw.value = r((v / 12000) * 3.517); });
    kw.addEventListener('input', () => { const v = Number(kw.value) || 0; tr.value = r(v / 3.517); btu.value = r((v / 3.517) * 12000, 0); });
    f.addEventListener('submit', (e) => e.preventDefault());
  }
</script>

<style>
  .ch-flow { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 981px) { .ch-flow { grid-template-columns: 1.3fr 1fr; } }
  .ch-diagram { width: 100%; height: auto; }
  .ch-diagram .t-w { font: 600 18px var(--font-heading); fill: #FFF; }
  .ch-diagram .t-ws { font: 500 14px var(--font-body); fill: #FFF; }
  .ch-diagram .t-b { font: 600 18px var(--font-heading); fill: #0047B9; }
  .ch-diagram .t-bs { font: 500 14px var(--font-body); fill: #444; }
  .ch-diagram .t-l { font: 600 14px var(--font-body); fill: #444; }
  .ch-diagram .t-p { font: 600 13px var(--font-heading); fill: #0047B9; }
  .pipe { fill: none; stroke-width: 14; stroke-linecap: round; }
  .pipe--cold { stroke: #CFE3FA; }
  .pipe--hot { stroke: #FDE2D2; }
  .flow { fill: none; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 10 14; animation: flow 1.6s linear infinite; }
  .flow--cold { stroke: #0774E2; }
  .flow--hot { stroke: #C2410C; }
  @keyframes flow { to { stroke-dashoffset: -48; } }
  @media (prefers-reduced-motion: reduce) { .flow { animation: none; } }
  .ch-steps { list-style: none; display: grid; gap: 16px; }
  .ch-steps li { display: flex; gap: 14px; }
  .ch-steps li > span { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--c-primary-600); color: #FFF; font-family: var(--font-heading); font-weight: 600; }
  .ch-steps h3 { font-size: 1.125rem; margin: 6px 0 4px; letter-spacing: -.5px; }
  .ch-steps p { margin: 0; font-size: 1rem; line-height: 1.55; }
  .conv { display: grid; gap: 14px; padding: 28px 24px; background: var(--c-bg-soft); border: .8px solid var(--c-accent); border-radius: var(--r-card); }
  .conv__t { display: flex; align-items: center; gap: 8px; margin: 0; font-family: var(--font-heading); font-weight: 600; color: var(--c-primary-900); }
  .chips--center { justify-content: center; margin-bottom: 32px; }
  .need { max-width: 720px; margin-inline: auto; padding: 28px; border-radius: var(--r-card); background: #FFF; border: 1px solid #E6E6E6; }
  .need h3 { color: var(--c-primary-900); font-size: 1.25rem; }
  .need .checks { margin-bottom: 12px; }
  .pf-card { max-width: 820px; margin-inline: auto; background: #FFF; border-radius: var(--r-card); padding: 28px 22px; box-shadow: 0 20px 40px -18px rgba(var(--c-primary-shadow), .35); }
  @media (min-width: 981px) { .pf-card { padding: 40px; } }
</style>
