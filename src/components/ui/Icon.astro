---
// Iconos SVG inline (astro-icon + Lucide, trazo 1,75 px). `name`: "lucide:snowflake" o "whatsapp" (src/icons).
import { Icon as AstroIcon } from 'astro-icon/components';
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls, label } = Astro.props;
---
<AstroIcon
  name={name}
  width={size}
  height={size}
  class:list={['icon', cls]}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
/>

<style is:global>
  .icon { flex: none; }
  svg.icon [stroke-width="2"] { stroke-width: 1.75; }
</style>
