---
// Panel móvil desde la derecha (300 ms), acordeón de Servicios, botones Llamar / WhatsApp.
// Bloquea el scroll y atrapa el foco.
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import { NAV } from '../../config/nav';
import { waHref, telHref } from '../../lib/data';
interface Props { waMsg: string }
const { waMsg } = Astro.props;
---
<div class="mm" id="mobile-menu" data-mm hidden>
  <div class="mm__overlay" data-mm-close></div>
  <div class="mm__panel" role="dialog" aria-modal="true" aria-label="Menú" data-ubicacion="header">
    <div class="mm__top">
      <Logo width={140} height={56} />
      <button type="button" class="mm__close" aria-label="Cerrar menú" data-mm-close><Icon name="lucide:x" size={28} /></button>
    </div>
    <nav aria-label="Móvil">
      <ul class="mm__list">
        {NAV.map((item) => (
          'children' in item ? (
            <li>
              <details class="mm__acc">
                <summary class="mm__link">{item.label}<Icon name="lucide:chevron-down" size={20} /></summary>
                <ul class="mm__sub">
                  {item.children.map((c) => <li><a href={c.href}><Icon name={c.icon} size={20} />{c.label}</a></li>)}
                </ul>
              </details>
            </li>
          ) : (
            <li><a href={item.href} class="mm__link">{item.label}</a></li>
          )
        ))}
      </ul>
    </nav>
    <div class="mm__ctas">
      <Button href={telHref} variant="phone" icon="lucide:phone" full>Llamar</Button>
      <Button href={waHref(waMsg)} variant="whatsapp" icon="whatsapp" full>WhatsApp</Button>
    </div>
  </div>
</div>

<script>
  const mm = document.querySelector<HTMLElement>('[data-mm]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  if (mm && burger) {
    const panel = mm.querySelector<HTMLElement>('.mm__panel')!;
    const focusables = () => [...panel.querySelectorAll<HTMLElement>('a, button, summary')].filter((el) => el.offsetParent !== null);
    const open = () => {
      mm.hidden = false;
      requestAnimationFrame(() => mm.classList.add('is-open'));
      document.documentElement.style.overflow = 'hidden';
      burger.setAttribute('aria-expanded', 'true');
      focusables()[0]?.focus();
    };
    const close = () => {
      mm.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      burger.setAttribute('aria-expanded', 'false');
      setTimeout(() => { mm.hidden = true; }, 300);
      burger.focus();
    };
    burger.addEventListener('click', open);
    mm.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-mm-close]')) close();
      else if ((e.target as HTMLElement).closest('a')) close();
    });
    mm.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      if (e.key !== 'Tab') return;
      const f = focusables();
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>

<style>
  .mm { position: fixed; inset: 0; z-index: 100; }
  .mm__overlay { position: absolute; inset: 0; background: rgba(11, 27, 63, .5); opacity: 0; transition: opacity .3s; }
  .mm__panel {
    position: absolute; inset: 0 0 0 auto; width: min(360px, 88vw); background: #FFF; overflow-y: auto;
    display: flex; flex-direction: column; padding: 8px 20px 24px; transform: translateX(100%); transition: transform .3s var(--ease-out-soft);
  }
  .mm.is-open .mm__overlay { opacity: 1; }
  .mm.is-open .mm__panel { transform: none; }
  .mm__top { display: flex; justify-content: space-between; align-items: center; height: 64px; margin-bottom: 8px; }
  .mm__close { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: none; color: var(--c-primary-500); }
  .mm__list { list-style: none; }
  .mm__link {
    display: flex; justify-content: space-between; align-items: center; padding: 14px 4px; min-height: 52px;
    font-family: var(--font-heading); font-weight: 500; font-size: 1.0625rem; color: var(--c-heading); text-decoration: none;
    border-bottom: 1px solid #EEE; cursor: pointer; list-style: none;
  }
  .mm__link::-webkit-details-marker { display: none; }
  .mm__acc[open] summary :global(.icon) { transform: rotate(180deg); }
  .mm__sub { list-style: none; padding: 6px 0 10px 8px; }
  .mm__sub a { display: flex; align-items: center; gap: 10px; padding: 10px 4px; color: var(--c-text); text-decoration: none; font-size: 1rem; min-height: 44px; }
  .mm__sub :global(.icon) { color: var(--c-primary-600); }
  .mm__ctas { display: grid; gap: 12px; margin-top: auto; padding-top: 24px; }
</style>
