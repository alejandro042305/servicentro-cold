---
// 5.4 Tipos de aire acondicionado: filtros por espacio, guía de decisión, mantenimiento y FAQ.
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import EquipmentTypes from '../../../components/sections/EquipmentTypes.astro';
import CTASection from '../../../components/sections/CTASection.astro';
import FAQ from '../../../components/sections/FAQ.astro';
import ContactSection from '../../../components/sections/ContactSection.astro';
import RelatedServices from '../../../components/sections/RelatedServices.astro';
import { SERVICIOS } from '../../../config/servicios';
import { waHref } from '../../../lib/data';
import { serviceLd } from '../../../lib/schema';
import equipos from '../../../content/equipos.json';
import faq from '../../../content/faq/aire-acondicionado.json';

const slug = 'aire-acondicionado';
const entry = await getEntry('servicios', slug);
const d = entry!.data as Record<string, any>;
const svc = SERVICIOS[slug];
---
<BaseLayout title={d.seo.title} description={d.seo.description} servicio={slug} readProgress
  schema={[serviceLd(Astro.site!, 'Aire acondicionado', d.seo.description, svc.href)]}>
  <PageHero title={d.hero.h1} subtitle={d.hero.sub} eyebrow={d.hero.eyebrow} photo={d.hero.foto} photoAlt={d.hero.fotoAlt}
    crumbs={[{ label: 'Servicios' }, { label: svc.nombre }]}>
    <span data-ubicacion="hero" style="display:contents">
      <Button href="#equipos" variant="white" icon="lucide:fan">Ver tipos de equipo</Button>
      <Button href={waHref(svc.waMsg)} variant="whatsapp" icon="whatsapp" bob>Pedir asesoría</Button>
    </span>
  </PageHero>

  <EquipmentTypes />

  <section class="section" id="cual" aria-labelledby="arbol-h">
    <div class="container">
      <SectionHeading id="arbol-h" eyebrow="Guía" title={equipos.arbol.titulo} />
      <ol class="tree">
        {equipos.arbol.pasos.map((p, i) => (
          <li class="tree__step" data-reveal="up">
            <span class="tree__n">{i + 1}</span>
            <p class="tree__q">{p.pregunta}</p>
            <p class="tree__a"><span class="tree__yes">Sí →</span> {p.si}</p>
            <p class="tree__a"><span class="tree__no">No →</span> {p.no}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTASection id="mantenimiento" titulo={d.mantenimiento.titulo} texto={d.mantenimiento.texto}>
    <Button href={d.mantenimiento.href} variant="white">{d.mantenimiento.cta}</Button>
  </CTASection>
  <FAQ items={faq} titulo="Preguntas sobre tipos de aire acondicionado" />
  <ContactSection servicioOrigen={slug} servicio="Instalación de aire acondicionado" waMsg={svc.waMsg} />
  <RelatedServices actual={slug} />
</BaseLayout>

<style>
  .tree { list-style: none; display: grid; gap: 14px; max-width: 820px; margin-inline: auto; }
  .tree__step { position: relative; padding: 20px 22px 20px 76px; background: #FFF; border: 1px solid #E6E6E6; border-radius: var(--r-card); }
  .tree__n { position: absolute; left: 20px; top: 20px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--c-primary-600); color: #FFF; font-family: var(--font-heading); font-weight: 600; }
  .tree__q { margin: 0 0 6px; font-family: var(--font-heading); font-weight: 600; font-size: 1.0625rem; color: var(--c-heading); }
  .tree__a { margin: 0; font-size: 1rem; line-height: 1.5; }
  .tree__yes { font-weight: 700; color: var(--c-whatsapp-btn); }
  .tree__no { font-weight: 700; color: var(--c-text-muted); }
</style>
