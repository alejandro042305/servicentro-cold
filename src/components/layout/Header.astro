---
// 3.3 Header [CLIENTE + CONVERSIÓN]: fijo, 112 → 76 px al hacer scroll; móvil 72 px.
// Se usa position: fixed + espaciador (en vez de sticky) para que el compactado no genere CLS.
// En celular/tablet (< 981 px) no hay menú de tres líneas: a la derecha van Llamar y WhatsApp,
// y la navegación de servicios está en la barra inferior (BottomNav).
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { NAV } from '../../config/nav';
import { WA_MSG_GENERAL } from '../../config/servicios';
import { waHref, telVisible, telHref } from '../../lib/data';

interface Props { waMsg?: string; servicio?: string }
const { waMsg = WA_MSG_GENERAL } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : href.startsWith('/servicios/') ? path.startsWith('/servicios/') : path.startsWith(href);
---
<div class="site-head" data-site-head>
  <header class="header" data-ubicacion="header">
    <div class="container container--wide header__in">
      <a href="/" class="header__logo" aria-label="Servicentro Cold, ir al inicio">
        <span class="header__logo-l"><Logo eager width={260} height={66} /></span>
        <span class="header__logo-s"><Logo width={180} height={46} /></span>
      </a>

      <nav class="nav" aria-label="Principal">
        <ul class="nav__list">
          {NAV.map((item) => (
            'children' in item ? (
              <li class="nav__item nav__item--has-sub" data-sub>
                <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                <button type="button" class="nav__toggle" aria-expanded="false" aria-label={`Abrir submenú de ${item.label}`}>
                  <Icon name="lucide:chevron-down" size={16} />
                </button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} class="sub__link" aria-current={path === c.href ? 'page' : undefined}><Icon name={c.icon} size={20} />{c.label}</a></li>
                  ))}
                  <li class="sub__urgent"><a href={telHref} class="sub__link sub__link--urgent" data-ubicacion="header"><Icon name="lucide:siren" size={20} />¿Falla urgente? Llámanos</a></li>
                </ul>
              </li>
            ) : (
              <li class="nav__item"><a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            )
          ))}
        </ul>
      </nav>

      <div class="header__cta">
        {telVisible && <a href={telHref} class="header__tel"><Icon name="lucide:phone" size={18} />{telVisible}</a>}
        <Button href={waHref(waMsg)} variant="primary" size="sm" icon="whatsapp" ubicacion="header" class="header__wa">Escríbenos</Button>
      </div>

      <div class="header__m">
        <a href={telHref} class="hm hm--tel" aria-label="Llamar"><Icon name="lucide:phone" size={22} /></a>
        <a href={waHref(waMsg)} class="hm hm--wa" aria-label="Escribir por WhatsApp" target="_blank" rel="noopener"><Icon name="whatsapp" size={24} /></a>
      </div>
    </div>
  </header>
</div>
<div class="head-spacer" aria-hidden="true"></div>

<script>
  const head = document.querySelector<HTMLElement>('[data-site-head]');
  if (head) {
    const onScroll = () => head.classList.toggle('is-compact', scrollY > 10);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  // Submenú accesible por teclado/toque (en escritorio también abre con hover/focus).
  document.querySelectorAll<HTMLElement>('[data-sub]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.nav__toggle')!;
    const set = (open: boolean) => { li.classList.toggle('is-open', open); btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', () => set(!li.classList.contains('is-open')));
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
    li.addEventListener('mouseleave', () => set(false));
  });
</script>

<style>
  .site-head { position: fixed; inset: 0 0 auto; z-index: 50; }
  .header { background: #FFF; height: 72px; transition: height .3s, box-shadow .3s; }
  .is-compact .header { box-shadow: var(--shadow-header-scrolled); }
  .head-spacer { height: 72px; }
  @media (min-width: 981px) {
    .header { height: 112px; }
    .is-compact .header { height: 76px; }
    .head-spacer { height: 112px; }
  }
  .header__in { display: flex; align-items: center; justify-content: space-between; height: 100%; gap: 24px; }
  .header__logo { display: flex; align-items: center; text-decoration: none; flex: none; }
  .header__logo-l { display: none; }
  @media (min-width: 981px) {
    .header__logo-l { display: block; }
    .header__logo-s { display: none; }
    .is-compact .header__logo-l { display: none; }
    .is-compact .header__logo-s { display: block; }
  }

  .nav { display: none; }
  @media (min-width: 981px) { .nav { display: block; margin-left: auto; } }
  .nav__list { display: flex; align-items: center; gap: 4px; list-style: none; }
  .nav__item { position: relative; display: flex; align-items: center; }
  .nav__link {
    display: block; padding: 31px 12px; font-family: var(--font-heading); font-weight: 500; font-size: var(--fs-nav); line-height: 1;
    color: var(--c-text); text-decoration: none; transition: opacity .4s ease-in-out, padding .3s;
  }
  .is-compact .nav__link { padding-block: 22px; }
  .nav__link:hover { opacity: .7; color: var(--c-text); }
  .nav__link.is-active { color: var(--c-link); }
  .nav__toggle { display: grid; place-items: center; width: 24px; height: 32px; margin-left: -8px; padding: 0; border: 0; background: none; color: var(--c-text); }
  .sub {
    position: absolute; top: 100%; left: 0; width: 240px; padding: 20px 0; list-style: none;
    background: #FFF; border-top: 2.4px solid var(--c-primary-500); box-shadow: var(--shadow-submenu);
    opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .3s, transform .3s, visibility .3s;
  }
  .nav__item--has-sub:hover .sub, .nav__item--has-sub.is-open .sub, .nav__item--has-sub:focus-within .sub {
    opacity: 1; visibility: visible; transform: none;
  }
  .sub__link {
    display: flex; align-items: center; gap: 10px; padding: 8px 20px; font-family: var(--font-heading); font-weight: 500;
    font-size: var(--fs-nav); line-height: 1.4; color: var(--c-text); text-decoration: none; transition: background-color .3s, color .3s;
  }
  .sub__link :global(.icon) { color: var(--c-primary-600); transition: color .3s; }
  .sub__link:hover { background: var(--c-primary-600); color: #FFF; }
  .sub__link:hover :global(.icon) { color: #FFF; }
  .sub__urgent { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--c-border); }
  .sub__link--urgent { color: var(--c-urgent); font-weight: 600; }
  .sub__link--urgent :global(.icon) { color: var(--c-urgent); }
  .sub__link--urgent:hover { background: var(--c-urgent); }

  .header__cta { display: none; align-items: center; gap: 20px; }
  @media (min-width: 981px) { .header__cta { display: flex; } }
  .header__tel { display: none; align-items: center; gap: 8px; font-family: var(--font-heading); font-weight: 600; font-size: 1rem; color: var(--c-primary-900); text-decoration: none; white-space: nowrap; }
  @media (min-width: 1280px) { .header__tel { display: inline-flex; } }

  .header__m { display: flex; gap: 10px; }
  @media (min-width: 981px) { .header__m { display: none; } }
  .hm { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: #FFF; text-decoration: none; }
  .hm:hover { color: #FFF; }
  .hm--tel { background: var(--c-phone-btn); }
  .hm--wa { background: var(--c-whatsapp-btn); }
</style>
